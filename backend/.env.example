# Copia este archivo como .env y completa los valores de tu PostgreSQL.
# El backend lee las variables DB_ (backend/app/database.py); nunca escribas
# claves en el codigo. backend/.env esta en .gitignore y no se publica.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=Matricula
DB_USER=postgres
DB_PASSWORD=tu_contrasena

# Recuperacion de clave por correo (opcional en desarrollo).
# Sin SMTP_HOST la API entra en modo desarrollo: el codigo de recuperacion
# se imprime en la consola de uvicorn y se devuelve en la respuesta.
# Con Gmail necesitas una "clave de aplicacion" (no tu clave normal):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tucorreo@gmail.com
# SMTP_PASS=tu_clave_de_aplicacion
# SMTP_FROM=no-reply@matricula-ucc.local
